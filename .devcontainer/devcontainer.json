{
  "name": "pyfolio-performance-mcp",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainer-community/devcontainer-features/opencode.ai:1": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [
    8000
  ],
  "mounts": [
    // "source=${localWorkspaceFolder}/.opencode-sessions,target=/home/vscode/.opencode-sessions,type=bind,consistency=cached",
    // "source=${env:HOME}/.config/opencode,target=/home/vscode/.config/opencode,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  }
}