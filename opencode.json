{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "portfolio": {
      "type": "local",
      "command": [
        "./venv/bin/python",
        "mcp_server.py"
      ],
      "environment": {
        "PORTFOLIO_FILE": "kommer.xml"
      },
